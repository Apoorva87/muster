# Muster — V1 target configuration.
# NOTE: nothing consumes these yet; the runtime is not implemented.
# Copy to .env once V1 lands:  cp .env.example .env

# --- Postgres (canonical semantic state) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muster
POSTGRES_USER=muster
POSTGRES_PASSWORD=change-me

# --- Restate (durable execution) ---
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
MUSTER_SERVICE_PORT=9080

# --- Artifacts ---
ARTIFACT_ROOT=./data/artifacts

# --- Local web UI (timeline + approvals) ---
WEB_PORT=8000

# --- Model harness ---
# LLM_PROVIDER: stub | anthropic | openai | ollama | claude_code | codex
#   stub         deterministic, no network, no cost — the default
#   anthropic    Claude via the official SDK      (uv sync --extra anthropic)
#   openai       OpenAI via the official SDK      (uv sync --extra openai)
#   ollama       a local model, OpenAI-compatible (uv sync --extra openai)
#   claude_code  the `claude` CLI as a subprocess agent — has tools + file access
#   codex        the `codex` CLI as a subprocess agent — has tools + file access
# Run `python -m app.main providers` to see what is usable on this machine.
LLM_PROVIDER=stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_EFFORT=medium
LLM_TIMEOUT=600

# --- Bus adapter (V2; local is the V1 default) ---
BUS_ADAPTER=local
