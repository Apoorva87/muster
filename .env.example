# Muster — V1 target configuration.
# NOTE: nothing consumes these yet; the runtime is not implemented.
# Copy to .env once V1 lands:  cp .env.example .env

# --- Postgres (canonical semantic state) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=muster
POSTGRES_USER=muster
POSTGRES_PASSWORD=change-me

# --- Restate (durable execution) ---
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
MUSTER_SERVICE_PORT=9080

# --- Artifacts ---
ARTIFACT_ROOT=./data/artifacts

# --- Local web UI (timeline + approvals) ---
WEB_PORT=8000

# --- Model harness ---
# Point at a local model or a hosted endpoint; the kernel must not care which.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=

# --- Bus adapter (V2; local is the V1 default) ---
BUS_ADAPTER=local
